# STM32CubeIDE build output. Regenerated on build, and the generated makefiles
# bake in absolute paths, so sharing them breaks other machines.
/Debug/
/Release/

# Design notes kept locally, deliberately not published.
/docs/

# Auto-regenerated by the indexer on every build.
.settings/language.settings.xml

.DS_Store

# Eclipse workspace state - machine-specific, not project source.
/.metadata/
